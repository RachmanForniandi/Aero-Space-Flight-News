<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.AeroSpaceFlightNews" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="colorPrimary">@color/lightBlue500</item>
        <item name="colorPrimaryVariant">@color/lightBlue700</item>
        <item name="colorOnPrimary">@color/lightBlue800</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <!-- Status bar color. -->
        <!-- Customize your theme here. -->
        <item name="android:windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.AeroSpaceFlightNews" parent="Base.Theme.AeroSpaceFlightNews" />



    <style name="Widget.App.BottomNav"
        parent="Widget.Material3.BottomNavigationView">

        <!-- Warna icon & text -->
        <item name="itemIconTint">@drawable/bottom_nav_selector</item>
        <item name="itemTextColor">@drawable/bottom_nav_selector</item>

        <!-- Label -->
        <item name="labelVisibilityMode">labeled</item>

        <!-- Indicator (Material 3 style) -->
        <item name="itemActiveIndicatorStyle">
            @style/Widget.App.BottomNav.ActiveIndicator
        </item>

    </style>

    <style name="Widget.App.BottomNav.ActiveIndicator">
        <item name="android:color">?attr/colorSecondaryContainer</item>
        <item name="android:height">32dp</item>
        <item name="shapeAppearance">
            @style/ShapeAppearance.App.BottomNav.Indicator
        </item>
    </style>

    <style name="ShapeAppearance.App.BottomNav.Indicator"
        parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="CustomActionBarStyle">
        <item name="android:background">@color/actionBarBackgroundColor</item>
    </style>

    <style name="customItemCardList">
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="strokeColor">@color/colorDivider</item>
    </style>

    <style name="CustomImageSplash">
        <item name="android:src">@drawable/dicoding_logo</item>
    </style>

    <style name="CustomColorTextStyle">
        <item name="android:textColor">@color/colorText</item>
    </style>

    <style name="CustomMaterialTextView">
        <item name="android:background">@drawable/bg_tv_item_dark_mini</item>
        <item name="android:textColor">@color/colorTextMaterial</item>
    </style>

    <style name="CustomContentScrim">
        <item name="android:background">@color/actionBarBackgroundColor</item>
    </style>

    <style name="customColorTintIcon">
        <item name="android:tint">@color/tintColorIcon</item>
    </style>


    <style name="CustomButtonStyle">
        <item name="android:backgroundTint">@color/actionBarBackgroundColor</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="setting_tv_actionBar" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/mountella_trial_bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="setting_tv_menu">
        <item name="android:textColor">@color/dark</item>
    </style>


</resources>