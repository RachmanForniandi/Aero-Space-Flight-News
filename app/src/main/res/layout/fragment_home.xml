<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".uiPresentation.home.HomeFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:liftOnScroll="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/menu_main"
            app:title=""
            app:titleTextColor="@color/white"
            style="@style/CustomActionBarStyle"
            app:elevation="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:scaleType="centerInside"
                android:text="@string/app_name"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:fontFamily="@font/belgrano_regular"
                app:tint="@color/white"/>
        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <TextView
        android:id="@+id/txt_lbl_Articles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        android:text="@string/here_is_top_10_articles"
        android:textStyle="bold"
        android:textSize="24sp"
        style="@style/CustomColorTextStyle"/>

    <ImageView
        android:id="@+id/img_data_empty_1"
        android:layout_width="160dp"
        android:layout_height="120dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:src="@drawable/ic_article_new"
        android:visibility="gone"
        android:contentDescription="@string/image_no_data_articles_available"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txt_lbl_Articles"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/txt_no_data_articles_available"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        android:layout_marginTop="10dp"
        android:text="@string/no_data_articles_available_please_try_again_later"
        android:textStyle="bold"
        android:fontFamily="@font/roboto_regular"
        app:layout_constraintTop_toBottomOf="@id/img_data_empty_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <!--<Button
        android:id="@+id/btn_reload_page_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="refresh articles"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/txt_no_data_articles_available"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clickable="false"
        tools:visibility="visible"/>-->

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerFrameLayoutCarrouselArticles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/txt_lbl_Articles"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <include layout="@layout/shimmer_item_carrousel" />

            <include layout="@layout/shimmer_item_carrousel" />

            <include layout="@layout/shimmer_item_carrousel" />
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_articles_carrousel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        tools:listitem="@layout/item_content_carrousel"
        app:layoutManager="com.google.android.material.carousel.CarouselLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/txt_lbl_Articles"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/txt_lbl_blogs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@id/shimmerFrameLayoutCarrouselArticles"
        app:layout_constraintStart_toStartOf="parent"
        android:text="@string/here_is_top_10_blogs"
        android:textStyle="bold"
        android:textSize="24sp"
        style="@style/CustomColorTextStyle"/>

    <ImageView
        android:id="@+id/img_data_empty_2"
        android:layout_width="160dp"
        android:layout_height="120dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:contentDescription="@string/image_no_data_blogs_available"
        android:src="@drawable/ic_blog_new"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txt_lbl_blogs"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/txt_no_data_blogs_available"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        android:layout_marginTop="10dp"
        android:text="@string/no_data_blogs_available_please_try_again_later"
        android:textStyle="bold"
        android:fontFamily="@font/roboto_regular"
        app:layout_constraintTop_toBottomOf="@id/img_data_empty_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible"
        style="@style/CustomColorTextStyle"/>

    <!--<Button
        android:id="@+id/btn_reload_page_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="refresh blogs"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/txt_no_data_blogs_available"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clickable="false"
        tools:visibility="visible"/>
-->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerFrameLayoutCarrouselBlogs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/txt_lbl_blogs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <include layout="@layout/shimmer_item_carrousel" />

            <include layout="@layout/shimmer_item_carrousel" />

            <include layout="@layout/shimmer_item_carrousel" />
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_blogs_carrousel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        tools:listitem="@layout/item_content_carrousel"
        android:orientation="horizontal"
        app:layoutManager="com.google.android.material.carousel.CarouselLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/txt_lbl_blogs"
        app:layout_constraintStart_toStartOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>