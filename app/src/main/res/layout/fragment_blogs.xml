<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".uiPresentation.blogs.BlogsFragment">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
        <TextView
            android:id="@+id/txt_label_blogs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/blogs"
            android:textStyle="bold"
            android:textSize="20sp"
            style="@style/CustomColorTextStyle"
            android:layout_marginTop="24dp"
            android:layout_marginStart="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!--<com.google.android.material.appbar.AppBarLayout
            android:id="@+id/blog_appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true"
            app:liftOnScroll="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar_blogs"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="Blogs"
                app:titleTextColor="@android:color/white"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
                style="@style/CustomActionBarStyle"/>
        </com.google.android.material.appbar.AppBarLayout>-->

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerFrameLayoutBlogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/txt_label_blogs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <include layout="@layout/shimmer_item_content" />

                <include layout="@layout/shimmer_item_content" />

                <include layout="@layout/shimmer_item_content" />

                <include layout="@layout/shimmer_item_content" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_blogs"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txt_label_blogs">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_blogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:listitem="@layout/item_content"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/txt_label_blogs"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ImageView
            android:id="@+id/img_data_blogs_empty"
            android:layout_width="360dp"
            android:layout_height="240dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:contentDescription="@string/image_no_data_blogs_available"
            android:src="@drawable/ic_calendar_event_error"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/txt_label_blogs"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:visibility="visible"/>

        <TextView
            android:id="@+id/txt_lbl_blogs_not_available"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_data_blogs_available"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textAlignment="center"
            android:visibility="gone"
            android:fontFamily="@font/roboto_regular"
            app:layout_constraintTop_toBottomOf="@id/img_data_blogs_empty"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible"/>

        <Button
            android:id="@+id/btn_reload_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/reload"
            style="@style/CustomButtonStyle"
            app:layout_constraintTop_toBottomOf="@id/txt_lbl_blogs_not_available"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="gone"
            android:clickable="false"
            tools:visibility="visible"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
