<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AeroSpaceFlightNews" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <!-- Status bar color. -->
        <item name="android:windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>


    </style>

    <style name="CustomColorTextStyle">
        <item name="android:textColor">@color/colorText</item>
    </style>

    <style name="customItemCardList">
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="strokeColor">@color/colorDivider</item>
    </style>

    <style name="Widget.App.BottomNavigation"
        parent="Widget.Material3.BottomNavigationView">

        <!-- Warna icon & text -->
        <item name="itemIconTint">@drawable/bottom_nav_selector</item>
        <item name="itemTextColor">@drawable/bottom_nav_selector</item>

        <!-- Label -->
        <item name="labelVisibilityMode">labeled</item>

        <!-- Indicator (Material 3 style) -->
        <item name="itemActiveIndicatorStyle">
            @style/Widget.App.BottomNav.ActiveIndicator
        </item>

    </style>
    <style name="Widget.App.BottomNav.ActiveIndicator">
        <item name="android:color">?attr/colorSecondaryContainer</item>
        <item name="android:height">32dp</item>
        <item name="shapeAppearance">
            @style/ShapeAppearance.App.BottomNav.Indicator
        </item>
    </style>



    <style name="CustomMaterialTextView">
        <item name="android:background">@drawable/bg_tv_item_white_mini</item>
        <item name="android:textColor">@color/colorTextMaterial</item>
    </style>

    <style name="setting_tv_menu">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CustomActionBarStyle">
        <item name="android:background">@color/actionBarBackgroundColor</item>
    </style>

    <style name="customTintIcon">
        <item name="android:tint">@color/tintColorIcon</item>
    </style>

    <style name="CustomImageSplash">
        <item name="android:src">@drawable/dicoding_cover_dark</item>
    </style>

    <style name="CustomButtonStyle">
        <item name="android:backgroundTint">@color/actionBarBackgroundColor</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>