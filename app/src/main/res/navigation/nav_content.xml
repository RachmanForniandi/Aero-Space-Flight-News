<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_content"
    app:startDestination="@id/articlesFragment">

    <!--<include app:graph="@navigation/favorite_navigation" />-->

    <fragment
        android:id="@+id/articlesFragment"
        android:name="rachman.forniandi.aerospaceflightnews.uiPresentation.articles.ArticlesFragment"
        android:label="fragment_articles"
        tools:layout="@layout/fragment_articles" >

        <action
            android:id="@+id/action_articlesFragment_to_articleDetailsFragment"
            app:destination="@id/articleDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/blogsFragment"
        android:name="rachman.forniandi.aerospaceflightnews.uiPresentation.blogs.BlogsFragment"
        android:label="fragment_blogs"
        tools:layout="@layout/fragment_blogs" >
        <action
            android:id="@+id/action_blogsFragment_to_detailBlogsFragment"
            app:destination="@id/detailBlogsFragment" />
    </fragment>


    <fragment
        android:id="@+id/articleDetailsFragment"
        android:name="rachman.forniandi.aerospaceflightnews.uiPresentation.detailContents.DetailArticlesFragment"
        android:label="article_detail_contents"
        tools:layout="@layout/fragment_detail_articles">
        <argument
            android:name="articleDetails"
            app:argType="rachman.forniandi.core.domain.entity.Contents"
             />
        <action
            android:id="@+id/action_articleDetailsFragment_to_detailContentsWebviewActivity"
            app:destination="@id/detailContentsWebviewActivity" />

    </fragment>
    <fragment
        android:id="@+id/detailBlogsFragment"
        android:name="rachman.forniandi.aerospaceflightnews.uiPresentation.detailContents.DetailBlogsFragment"
        android:label="fragment_detail_blogs"
        tools:layout="@layout/fragment_detail_blogs">
        <argument
            android:name="blogDetails"
            app:argType="rachman.forniandi.core.domain.entity.Contents"
             />
        <action
            android:id="@+id/action_detailBlogsFragment_to_detailContentsWebviewActivity"
            app:destination="@id/detailContentsWebviewActivity" />

    </fragment>
    <activity
        android:id="@+id/detailContentsWebviewActivity"
        android:name="rachman.forniandi.aerospaceflightnews.uiPresentation.detailContents.DetailContentsWebviewActivity"
        android:label="activity_detail_contents_webview"
        tools:layout="@layout/activity_detail_contents_webview" >
        <argument
            android:name="urlWeb"
            app:argType="rachman.forniandi.core.domain.entity.Contents"
             />
    </activity>

    <fragment
        android:id="@+id/favoriteContentFragment"
        android:name="rachman.forniandi.favorite.ui.FavoriteContentFragment"
        android:label="fragment_favorite_content"
        tools:layout="@layout/fragment_favorite_content">

        <action
            android:id="@+id/action_favoriteContentFragment_to_articleDetailsFragment"
            app:destination="@id/articleDetailsFragment" />

        <action
            android:id="@+id/action_favoriteContentFragment_to_detailBlogsFragment"
            app:destination="@id/detailBlogsFragment" />
    </fragment>

    <action
        android:id="@+id/action_global_favorite"
        app:destination="@id/favoriteContentFragment" />


</navigation>